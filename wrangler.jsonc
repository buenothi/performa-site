{
  // O nome precisa ser igual ao do Worker criado no painel da Cloudflare.
  "name": "performa-site",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  // Mantém as variáveis e secrets configurados no painel a cada deploy.
  "keep_vars": true,
  "observability": { "enabled": true }
}
